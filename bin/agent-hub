#!/usr/bin/env python3
"""agent-hub: the old name of the jarviee command. Kept so existing symlinks and the old app keep working."""
import os
import sys
from pathlib import Path

if __name__ == "__main__":
    target = Path(__file__).resolve().with_name("jarviee")
    os.execv(sys.executable, [sys.executable, str(target), *sys.argv[1:]])
